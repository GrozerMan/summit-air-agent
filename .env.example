LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional
DEMO_CALLER_ID=
HUMAN_TRANSFER_NUMBER=
SLACK_WEBHOOK_URL=

# Postgres for the deployed agent (e.g. Neon, ?sslmode=require). Unset: data/summit.db.
DATABASE_URL=
# A laptop worker next to the cloud deploy: use a different name so it never takes
# calls the phone number's dispatch rule sends to "summit-air".
AGENT_NAME=
